{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "stlinkgdbtarget",
      "request": "launch",
      "name": "Leaf ST-LINK (FLASH + debug)",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Leaf",
      "runEntry": "main",
      "serverInterface": "SWD",
      "serverSerialNumber": "${input:probeSerial}",
      "imagesAndSymbols": [
        {
          "imageFileName": "${workspaceFolder}/build/Debug/Fan_Blade.elf"
        }
      ],
      "serverRtos": {
        "enabled": false
      },
      "serverSemihosting": {
        "enabled": false
      },
      "serverReset": "Software system reset"
    }
  ],
  "inputs": [
    {
      "id": "probeSerial",
      "type": "promptString",
      "description": "ST-LINK serial number for this board (Flash writes hardware)"
    }
  ]
}
